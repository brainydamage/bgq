#!/bin/sh
# Короткий вход в инструменты: ./bgq init | parse | osm <город> | geo | map | table | kml | --help
set -e
root=$(cd "$(dirname "$0")" && pwd)

if ! command -v node >/dev/null 2>&1; then
  echo "✗ Нет node в PATH — нужен Node 24+ (nvm use)" >&2
  exit 2
fi
if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)'; then
  echo "✗ Нужен Node 24+, сейчас $(node -v) — выполните: nvm use" >&2
  exit 2
fi
if [ ! -d "$root/node_modules" ]; then
  echo "✗ Зависимости не установлены — выполните: corepack pnpm install" >&2
  exit 2
fi

case "$1" in
  geo | osm) exec node "$root/packages/geo/src/cli.ts" "$@" ;;
  map) shift; exec node "$root/apps/digitizer/server/start.ts" "$@" ;;
  table) shift; exec node "$root/packages/table/src/cli.ts" "$@" ;;
  kml) shift; exec node "$root/packages/export/src/cli.ts" "$@" ;;
  *) exec node "$root/packages/ingest/src/cli.ts" "$@" ;;
esac
