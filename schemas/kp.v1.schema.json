{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bgq.local/schemas/kp.v1.schema.json",
  "title": "kp",
  "type": "object",
  "required": [
    "id",
    "number",
    "kind",
    "points",
    "eligible",
    "title",
    "description",
    "struck",
    "links",
    "answerKind",
    "raw"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(\\d{1,3}[А-ЯЁ]?(#\\d+)?|[a-z][a-z0-9-]*)$"
    },
    "number": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "classic",
        "riddle",
        "task",
        "photo"
      ]
    },
    "points": {
      "type": "number",
      "minimum": 0
    },
    "pointsMax": {
      "type": "number",
      "minimum": 0
    },
    "mapColor": {
      "enum": [
        "red",
        "blue",
        "green"
      ]
    },
    "note": {
      "enum": [
        "velo_only",
        "pro_only"
      ]
    },
    "eligible": {
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "address": {
      "type": "object",
      "required": [
        "raw",
        "street",
        "house"
      ],
      "properties": {
        "raw": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "house": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "alt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "struck": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraPhoto": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "kind"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "maps",
              "video",
              "other"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "answerKind": {
      "enum": [
        "text",
        "photo",
        "drawing",
        "judge",
        "video"
      ]
    },
    "loc": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "source",
        "confidence"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "source": {
          "enum": [
            "geocode",
            "map",
            "manual",
            "gmaps_link"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "altLocs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lat",
          "lon",
          "source",
          "confidence"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "source": {
            "enum": [
              "geocode",
              "map",
              "manual",
              "gmaps_link"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "window": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "to": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "additionalProperties": false
    },
    "serviceMin": {
      "type": "number",
      "minimum": 0
    },
    "raw": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
