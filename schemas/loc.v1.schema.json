{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bgq.local/schemas/loc.v1.schema.json",
  "title": "loc",
  "type": "object",
  "required": [
    "lat",
    "lon",
    "source",
    "confidence"
  ],
  "properties": {
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "source": {
      "enum": [
        "geocode",
        "map",
        "manual",
        "gmaps_link"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
