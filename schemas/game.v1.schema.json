{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bgq.local/schemas/game.v1.schema.json",
  "title": "game",
  "type": "object",
  "required": [
    "id",
    "city",
    "date",
    "tz",
    "start",
    "finish",
    "category",
    "mode",
    "allowedColors",
    "pointsRule"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tz": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "depart": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "loc": {
          "type": "object",
          "required": [
            "lat",
            "lon",
            "source",
            "confidence"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "source": {
              "enum": [
                "geocode",
                "map",
                "manual",
                "gmaps_link"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "durationMin": {
      "type": "integer",
      "minimum": 1
    },
    "finish": {
      "type": "object",
      "required": [
        "deadline",
        "graceMin",
        "penaltyPerMin"
      ],
      "properties": {
        "deadline": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "graceMin": {
          "type": "integer",
          "minimum": 0
        },
        "penaltyPerMin": {
          "type": "number",
          "minimum": 0
        },
        "address": {
          "type": "string"
        },
        "loc": {
          "type": "object",
          "required": [
            "lat",
            "lon",
            "source",
            "confidence"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "source": {
              "enum": [
                "geocode",
                "map",
                "manual",
                "gmaps_link"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "category": {
      "enum": [
        "pro",
        "velo"
      ]
    },
    "mode": {
      "enum": [
        "foot",
        "bike"
      ]
    },
    "allowedColors": {
      "type": "array",
      "items": {
        "enum": [
          "red",
          "blue",
          "green"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pointsRule": {
      "type": "object",
      "required": [
        "kind",
        "divisor"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "floor_div"
        },
        "divisor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
